{
  "default": {

    "parallel": 5,
    "paths":
     [
      "src/features/**/*.feature"
    ],

    "require": 
    [
      "src/stepDefinitions/**/*.ts",
      "src/hooks/**/*.ts"
    ],

    "requireModule": 
    [
      "ts-node/register"
    ],

    "format": 
    [
      "progress",
      "json:reports/cucumber-report.json",
      "allure-cucumberjs/reporter"
      
    ],
  
    "format options":
    {
      "resultsDir":"allure-results"


    },
     

    "publishQuiet": true
  }
}